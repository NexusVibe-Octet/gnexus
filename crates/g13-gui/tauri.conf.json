{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G Nexus",
  "mainBinaryName": "G Nexus",
  "version": "1.1.0",
  "identifier": "org.g13.studio",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "G Nexus",
        "width": 1180,
        "height": 900,
        "minWidth": 980,
        "minHeight": 760,
        "visible": false,
        "create": false,
        "backgroundColor": "#181b22"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "G Nexus",
    "shortDescription": "Configuration du Logitech G13 (remplace Logitech Gaming Software)",
    "longDescription": "G Nexus pilote le clavier Logitech G13, la souris G502 X PLUS et le casque PRO X Wireless : touches, macros, profils par application, éclairage et égaliseur.",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
